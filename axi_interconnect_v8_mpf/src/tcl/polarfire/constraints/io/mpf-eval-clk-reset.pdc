# Microsemi I/O Physical Design Constraints file

# User I/O Constraints file 



# Family: PolarFire , Die: MPF300T_ES , Package: FCG1152

# Date generated: Fri Sep 28 16:36:17 2018 


# 
# User Locked I/O Bank Settings
# 

set_iobank -bank_name Bank4  \
    -vcci 2.50               \
    -fixed true

set_iobank -bank_name Bank6  \
    -vcci 1.80               \
    -fixed true



# All the GPIO and SPI , UART signals are connected to the Bank 6 which is 1.8V

set_io -port_name REF_CLK_50MHZ  \
    -pin_name E25            \
    -fixed true              \
    -DIRECTION INPUT
    
    
set_io -port_name RESET_N  \
    -pin_name K22          \
    -fixed true            \
    -DIRECTION INPUT






